# chat-vault remote mode settings for docker-compose.yml.
# Copy to .env and fill in. This file holds NO secrets: those go in ./secrets/
# (see README "Remote mode"). Never commit .env or ./secrets/.

# Image tag to run (a release like 0.2.0, or "latest").
CHAT_VAULT_VERSION=latest

# Public HTTPS origin served by the Cloudflare Tunnel. No path.
# Add the connector in Claude/ChatGPT as: <this URL>/mcp
CHAT_VAULT_PUBLIC_URL=https://vault.example.com

# Your numeric GitHub user id (NOT your username). Find it with:
#   curl -s https://api.github.com/users/<your-username> | grep '"id"'
CHAT_VAULT_ALLOWED_GITHUB_USER_ID=0

# Client ID of your GitHub App (the secret goes in ./secrets/github_client_secret).
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx

# Host folder containing chat-vault.db (mounted read-only).
CHAT_VAULT_DATA_DIR=/srv/chat-vault/data

# Requests per minute per client IP.
CHAT_VAULT_RATE_LIMIT_PER_MINUTE=60
